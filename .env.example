# ArchitectFlow configuration. Copy to .env (never commit real values) or set in your environment.
# Every variable is optional for local development; defaults are shown.

# --- API (apps/api) ---
# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver).
ARCHITECTFLOW_DATABASE_URL=postgresql+psycopg://architectflow@127.0.0.1:54329/architectflow
# Set false ONLY for plain-http local development; production must serve HTTPS.
ARCHITECTFLOW_SECURE_COOKIES=true
ARCHITECTFLOW_SESSION_TTL_HOURS=168
# AI provider: example (default, deterministic, no network), openai (any OpenAI-compatible
# Chat Completions server) or anthropic. Designs are sent to the provider only when set.
ARCHITECTFLOW_AI_PROVIDER=example
ARCHITECTFLOW_AI_API_KEY=
ARCHITECTFLOW_AI_MODEL=
ARCHITECTFLOW_AI_BASE_URL=
ARCHITECTFLOW_AI_TIMEOUT_SECONDS=60
ARCHITECTFLOW_AI_REQUESTS_PER_MINUTE=10
ARCHITECTFLOW_LOGIN_ATTEMPTS_PER_MINUTE=10
ARCHITECTFLOW_EXPORTS_PER_MINUTE=60
# Where rate-limit counts live: database (default; PostgreSQL table rate_limit_hits, shared by
# every API process and serverless instance) or memory (per process; tests and offline use).
ARCHITECTFLOW_RATE_LIMIT_BACKEND=database
ARCHITECTFLOW_MAX_REQUEST_BYTES=2000000

# --- Web (apps/web), read at BUILD time ---
ARCHITECTFLOW_API_ORIGIN=http://127.0.0.1:8000
