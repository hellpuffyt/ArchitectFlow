{
  "name": "architectflow",
  "version": "0.1.0",
  "description": "Install ArchitectFlow into a repository: your AI coding agent reads the real source and generates a source-grounded, evidence-backed system design.",
  "type": "module",
  "license": "(MIT OR Apache-2.0)",
  "homepage": "https://github.com/hellpuffyt/ArchitectFlow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellpuffyt/ArchitectFlow.git",
    "directory": "apps/cli"
  },
  "bin": {
    "architectflow": "dist/bin/architectflow.js"
  },
  "files": [
    "dist",
    "skill-template",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node bin/architectflow.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "architecture",
    "system-design",
    "claude-code",
    "skill",
    "diagrams",
    "c4",
    "mermaid",
    "documentation"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0"
  }
}
